#!/usr/bin/env bash
# Builds the Counter example and runs the host benchmark in release mode.
#   Scripts/bench [calls=1000000] [cycles=100]
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
OUT="$ROOT/.build/bench"
"$ROOT/Scripts/cordis-build" --id counter --out "$OUT/libcounter.dylib" "$ROOT/Examples/Counter/Counter.swift"
swift build -c release --package-path "$ROOT" --product cordis-bench >/dev/null
"$ROOT/.build/release/cordis-bench" bench "$OUT/libcounter.dylib" "${1:-1000000}" "${2:-100}"
