#!/usr/bin/env bash
# cordis-build: compile an Embedded Swift cordis plugin into an unloadable dylib.
#
#   cordis-build --id <plugin-id> --out <path.dylib> [--entry <Type>] [-D <FLAG>]... <sources...>
#
# The plugin sources are compiled together with CordisValue and CordisKit into one module
# (unique per build: id + content hash), linked with plain clang, and exported symbols are
# restricted to the three cordis_plugin_* entry points. The build fails if the dylib contains
# any __swift5_* or __objc_* section, because such an image can never be unmapped by dlclose.
#
# Toolchain resolution (first one that has usr/lib/swift/embedded wins):
#   1. $CORDIS_TOOLCHAIN
#   2. newest swiftly toolchain in ~/.swiftly/toolchains
#   3. newest ~/Library/Developer/Toolchains/*.xctoolchain (versioned names before swift-latest)
#   4. /Library/Developer/Toolchains/swift-latest.xctoolchain
set -euo pipefail

die() { echo "cordis-build: error: $*" >&2; exit 1; }
usage() { sed -n '4,4p' "$0" | sed 's/^# *//' >&2; exit 2; }

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ID="" OUT="" ENTRY="Plugin" TARGET="${CORDIS_TARGET:-arm64-apple-macos26}"
DEFINES=() SOURCES=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    --id) ID="${2:-}"; shift 2 ;;
    --out|-o) OUT="${2:-}"; shift 2 ;;
    --entry) ENTRY="${2:-}"; shift 2 ;;
    -D) DEFINES+=("-D" "${2:-}"); shift 2 ;;
    -D*) DEFINES+=("$1"); shift ;;
    -h|--help) usage ;;
    -*) die "unknown option $1" ;;
    *) SOURCES+=("$1"); shift ;;
  esac
done

[[ -n "$ID" && -n "$OUT" && ${#SOURCES[@]} -gt 0 ]] || usage
[[ "$ID" =~ ^[A-Za-z0-9._-]+$ ]] || die "plugin id must match [A-Za-z0-9._-]+ (got '$ID')"
[[ "$ENTRY" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || die "invalid --entry '$ENTRY'"
for s in "${SOURCES[@]}"; do [[ -f "$s" ]] || die "no such source: $s"; done

# --- toolchain -------------------------------------------------------------------------------
has_embedded() { [[ -x "$1/usr/bin/swiftc" && -d "$1/usr/lib/swift/embedded" ]]; }
resolve_toolchain() {
  if [[ -n "${CORDIS_TOOLCHAIN:-}" ]]; then
    has_embedded "$CORDIS_TOOLCHAIN" || die "CORDIS_TOOLCHAIN=$CORDIS_TOOLCHAIN has no embedded stdlib"
    echo "$CORDIS_TOOLCHAIN"; return
  fi
  local dir tc
  for dir in "$HOME/.swiftly/toolchains" "$HOME/Library/Developer/Toolchains"; do
    [[ -d "$dir" ]] || continue
    # Versioned toolchains, newest first, then anything else (e.g. the swift-latest symlink).
    while IFS= read -r tc; do
      if has_embedded "$tc"; then echo "$tc"; return; fi
    done < <( { ls -1d "$dir"/*/ 2>/dev/null | sed 's:/$::' | grep -E '/[^/]*[0-9]+\.[0-9]+[^/]*$' | sort -rV;
                ls -1d "$dir"/*/ 2>/dev/null | sed 's:/$::' | grep -vE '/[^/]*[0-9]+\.[0-9]+[^/]*$'; } )
  done
  tc=/Library/Developer/Toolchains/swift-latest.xctoolchain
  has_embedded "$tc" || die "no toolchain with an Embedded Swift stdlib found (set CORDIS_TOOLCHAIN)"
  echo "$tc"
}
TC="$(resolve_toolchain)"
ARCH="${TARGET%%-*}"
SDK="$(xcrun --show-sdk-path)"
EMBEDDED_LIB="$TC/usr/lib/swift/embedded/${ARCH}-apple-macos"

# --- unique module name ----------------------------------------------------------------------
KIT_SOURCES=("$ROOT"/Sources/CordisValue/*.swift "$ROOT"/Sources/CordisKit/*.swift)
HASH="$( { printf '%s\n' "$ID" "$ENTRY" "$TARGET" "$TC" "${DEFINES[@]+"${DEFINES[@]}"}";
           cat "${SOURCES[@]}" "${KIT_SOURCES[@]}" "$ROOT/Sources/CCordis/include/cordis.h"; } \
         | shasum -a 256 | cut -c1-12)"
MODULE="CordisPlugin_$(printf '%s' "$ID" | tr -c 'A-Za-z0-9_' '_')_$HASH"

WORK="$(mktemp -d "${TMPDIR:-/tmp}/cordis-build.XXXXXX")"
trap 'rm -rf "$WORK"' EXIT

# --- generated exports -----------------------------------------------------------------------
cat > "$WORK/__cordis_exports.swift" <<EOF
// Generated by cordis-build. Do not edit.
import CCordis
let __cordisPluginID = "$ID"
@_cdecl("cordis_plugin_manifest")
public func __cordis_plugin_manifest() -> cordis_bytes { _cordisExportManifest($ENTRY.self, id: __cordisPluginID) }
@_cdecl("cordis_plugin_apply")
public func __cordis_plugin_apply(_ host: UnsafePointer<cordis_host>?) -> Int32 {
  _cordisExportApply($ENTRY.self, id: __cordisPluginID, host)
}
@_cdecl("cordis_plugin_dispose")
public func __cordis_plugin_dispose() { _cordisExportDispose($ENTRY.self) }
EOF
printf '%s\n' _cordis_plugin_manifest _cordis_plugin_apply _cordis_plugin_dispose > "$WORK/exports.txt"

# --- compile + link --------------------------------------------------------------------------
"$TC/usr/bin/swiftc" -target "$TARGET" -sdk "$SDK" \
  -enable-experimental-feature Embedded -wmo -parse-as-library -O \
  -module-name "$MODULE" -I "$ROOT/Sources/CCordis/include" \
  ${DEFINES[@]+"${DEFINES[@]}"} \
  -c "${SOURCES[@]}" "${KIT_SOURCES[@]}" "$WORK/__cordis_exports.swift" \
  -o "$WORK/plugin.o"

clang -target "$TARGET" -dynamiclib "$WORK/plugin.o" "$EMBEDDED_LIB/libswiftUnicodeDataTables.a" \
  -Wl,-dead_strip -Wl,-exported_symbols_list,"$WORK/exports.txt" \
  -install_name "@rpath/$MODULE.dylib" -o "$WORK/plugin.dylib"

# --- unloadability gate ----------------------------------------------------------------------
BAD="$(otool -l "$WORK/plugin.dylib" | awk '$1 == "sectname" && ($2 ~ /^__swift5_/ || $2 ~ /^__objc_/) { print $2 }' | sort -u)"
if [[ -n "$BAD" ]]; then
  die "output contains runtime-registered sections and could never be unloaded: $(echo $BAD)"
fi
for sym in cordis_plugin_manifest cordis_plugin_apply cordis_plugin_dispose; do
  nm -gU "$WORK/plugin.dylib" | grep -q " _$sym\$" || die "missing export $sym"
done

mkdir -p "$(dirname "$OUT")"
# Atomic replace so file watchers never observe a half-written dylib.
cp "$WORK/plugin.dylib" "$OUT.tmp.$$" && mv -f "$OUT.tmp.$$" "$OUT"
echo "cordis-build: $ID -> $OUT (module $MODULE, toolchain $(basename "$TC"): $("$TC/usr/bin/swiftc" --version 2>/dev/null | head -1 | sed -E 's/.*Swift version ([^ ]+).*/\1/'))"
